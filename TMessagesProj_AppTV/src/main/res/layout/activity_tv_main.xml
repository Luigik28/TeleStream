<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- Loading / status state -->
    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="#4FC3F7" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#99AABB"
            android:textSize="22sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

        <!-- Shown during "waiting for phone" state -->
        <TextView
            android:id="@+id/instruction_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone" />

        <!-- Shown after waiting timeout -->
        <TextView
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Riprova"
            android:textColor="#4FC3F7"
            android:textSize="22sp"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Events table (initially hidden) -->
    <LinearLayout
        android:id="@+id/events_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <!-- Fixed column-title header — never scrolls, always visible. Widths roughly line up
             with each row's category strip / event content / watchers / time columns below. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/header_sport"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="SPORT"
                android:textColor="#5A7A99"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:text="EVENTO"
                android:textColor="#5A7A99"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="SPETTATORI"
                android:textColor="#5A7A99"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="INIZIO"
                android:textColor="#5A7A99"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="4dp"
            android:background="#1E2A35" />

        <!-- Scrollable events list — SmoothFocusScrollView forces smooth D-PAD scroll -->
        <org.telegram.tv.ui.SmoothFocusScrollView
            android:id="@+id/events_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <!-- FrameLayout lets the animated focus cursor overlay the list. Bottom padding
                 gives the last row (and its focus-cursor highlight) breathing room to scroll
                 fully into view instead of sitting flush against the scroll viewport edge,
                 right above the footer row, where it looked clipped. -->
            <FrameLayout
                android:id="@+id/events_list_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:id="@+id/events_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </FrameLayout>

        </org.telegram.tv.ui.SmoothFocusScrollView>

    </LinearLayout>

    <!-- Streaming player (initially hidden) -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#000000">

        <FrameLayout
            android:id="@+id/stream_player_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top overlay with event title and back hint -->
        <LinearLayout
            android:id="@+id/stream_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#AA000000"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/stream_event_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[BACK] Torna agli eventi"
                android:textColor="#99FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Loading overlay for stream -->
        <LinearLayout
            android:id="@+id/stream_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#4FC3F7" />

            <TextView
                android:id="@+id/stream_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#99AABB"
                android:textSize="18sp"
                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
