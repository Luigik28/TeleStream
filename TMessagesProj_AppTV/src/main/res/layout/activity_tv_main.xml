<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- Loading / status state -->
    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="#4FC3F7" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#99AABB"
            android:textSize="22sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

        <TextView
            android:id="@+id/instruction_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone" />

        <TextView
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Riprova"
            android:textColor="#4FC3F7"
            android:textSize="22sp"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone" />

    </LinearLayout>

    <!--
        Events container: navigation rail (72dp, always visible) + content area,
        with a modal drawer that overlays from the left. Initially hidden.
    -->
    <FrameLayout
        android:id="@+id/events_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Content area: full-screen base layer (drawn first so rail + drawer overlay it) -->
        <FrameLayout
            android:id="@+id/content_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/events_list_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <org.telegram.tv.ui.SmoothFocusScrollView
                    android:id="@+id/events_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/events_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="88dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="24dp" />

                </org.telegram.tv.ui.SmoothFocusScrollView>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/settings_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="80dp"
                android:paddingEnd="80dp"
                android:visibility="gone" />

        </FrameLayout>

        <!--
            Scrim: dims the content when the nav panel is expanded.
            Z-order below the nav panel so the panel content stays crisp.
        -->
        <View
            android:id="@+id/drawer_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:visibility="invisible"
            android:clickable="true"
            android:focusable="false" />

        <!--
            Unified navigation panel — always at x=0.
            clipBounds = 72dp when collapsed (icon-only rail), 320dp when expanded (icon + label).
            Background colour and clip are animated in code; no XML background set here.
            Each item inside uses a fixed 72dp icon slot so the icon is always centred
            at x=36dp regardless of whether the panel is collapsed or expanded.
        -->
        <LinearLayout
            android:id="@+id/nav_rail"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header 80dp: [72dp avatar slot] + [name / username] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Avatar lives in a fixed 72dp slot so it stays centred when collapsed -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:id="@+id/user_avatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/user_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#E6E1E5"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/user_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#938F99"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- outlineVariant divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#49454F"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <!-- Nav items: populated programmatically; each row = [72dp icon slot] + [label] -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/nav_rail_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

            </ScrollView>

            <!-- outlineVariant divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#49454F"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <!-- Settings row: [72dp icon slot] + [label] -->
            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:focusable="true"
                android:clickable="true"
                android:focusableInTouchMode="false"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings_nav" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Impostazioni"
                    android:textColor="#CAC4D0"
                    android:textSize="14sp"
                    android:layout_marginEnd="16dp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Streaming player (initially hidden) -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#000000">

        <FrameLayout
            android:id="@+id/stream_player_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/stream_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#AA000000"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/stream_event_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[BACK] Torna agli eventi"
                android:textColor="#99FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/stream_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#4FC3F7" />

            <TextView
                android:id="@+id/stream_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#99AABB"
                android:textSize="18sp"
                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
